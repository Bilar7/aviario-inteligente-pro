{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Aviário production",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Publish Firestore Rules",
			"type": "shell",
			"command": "npx.cmd",
			"args": [
				"--yes",
				"firebase-tools@latest",
				"deploy",
				"--only",
				"firestore:rules",
				"--project",
				"aviario-inteligente-pro"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Generate Aviário brand assets",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build:brand-assets"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Aviário smoke test",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"test"
			],
			"isBackground": false,
			"group": "test"
		},
	]
}